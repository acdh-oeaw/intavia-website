{
	"name": "@acdh-oeaw/intavia-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^26"
	},
	"packageManager": "pnpm@12.23.0",
	"scripts": {
		"build": "run-s build:site assets:prune generate:search-index",
		"build:site": "astro build",
		"dev": "astro dev",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"generate:search-index": "pagefind --site ./dist/",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "oxlint --report-unused-disable-directives",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "stylelint \"./**/*.@(astro|css)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup",
		"setup": "is-in-ci || lefthook install",
		"start": "astro preview",
		"sync": "astro sync",
		"test": "node --test ./scripts/*.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "astro check",
		"validate": "run-s format:check lint:check types:check test test:e2e",
		"assets:prune": "node ./scripts/prune-assets.ts",
		"refresh:remote-content": "REMOTE_CONTENT_REFRESH=1 pnpm run build"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.1.12",
		"@acdh-oeaw/validate-env": "^0.0.3",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/react": "^7.1.9",
		"@astrojs/rss": "^4.0.7",
		"@astrojs/sitemap": "^3.7.6",
		"@floating-ui/dom": "^1.6.10",
		"@fontsource/abel": "^5.0.12",
		"@iconify-json/lucide": "^1.1.207",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.10",
		"@mdx-js/mdx": "^3.0.1",
		"@pagefind/default-ui": "^1.1.0",
		"@shikijs/rehype": "^1.13.0",
		"@sindresorhus/slugify": "^2.2.1",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"cva": "1.0.0-beta.12",
		"date-fns": "^3.6.0",
		"estree-util-value-to-estree": "^3.1.2",
		"hast-util-heading": "^3.0.0",
		"hast-util-heading-rank": "^3.0.0",
		"hast-util-to-string": "^3.0.0",
		"lucide-react": "^0.428.0",
		"mdast-util-mdx-jsx": "^3.1.2",
		"pagefind": "^1.1.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.0",
		"remark-mdx-frontmatter": "^5.0.0",
		"remark-smartypants": "^3.0.2",
		"retext-smartypants": "^6.1.0",
		"sharp": "^0.35.5",
		"shiki": "^1.13.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0",
		"valibot": "^0.37.0",
		"vfile": "^6.0.2",
		"vite": "^8.3.8"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.12",
		"@astrojs/ts-plugin": "^1.11.0",
		"@playwright/test": "^1.65.1",
		"@types/estree": "^1.0.8",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/mdx": "^2.0.13",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.1",
		"axe-playwright": "^2.2.2",
		"ci-info": "^4.5.0",
		"dotenv": "^16.4.5",
		"dotenv-expand": "^11.0.6",
		"npm-run-all2": "^9.1.0",
		"postcss": "^8.5.0",
		"schema-dts": "^1.1.2",
		"stylelint": "^18.1.0",
		"tailwindcss": "^4.3.5",
		"type-fest": "^4.25.0",
		"typescript": "^6.0.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.13.1",
			"onFail": "download"
		}
	}
}
