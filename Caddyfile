:3000 {
	root * /usr/share/caddy
	encode zstd gzip

	@baseRoot expression `'{$APP_BASE_PATH}' != '' && {http.request.uri.path} == '{$APP_BASE_PATH}'`
	redir @baseRoot {$APP_BASE_PATH}/ 308

	handle_path {$APP_BASE_PATH}/* {
		# Preserve the linked-data redirects previously handled by Astro SSR.
		@linkedData path /apis/* /bs/* /sbi/* /bnet/* /name/* /provided_*
		redir @linkedData "https://intavia-ts-backend.acdh-dev.oeaw.ac.at/?query=DESCRIBE%20%3Chttp%3A%2F%2Fwww.intavia.eu{path}%3E" 302
		@idm path /idm-core /idm-core/*
		redir @idm https://raw.githubusercontent.com/InTaVia/idm-rdf/refs/heads/main/idm-OWL/intavia_idm1.1.ttl 302
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/
		file_server
	}

	handle {
		error 404
	}

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
